# ==============================================================================
# Mehrere-Discord-Bots - Umgebungsvariablen-Vorlage (.env.example)
#
# WICHTIGER SICHERHEITSHINWEIS:
# Diese Datei enthält AUSSCHLIESSLICH Platzhalter und keine echten Geheimnisse!
# Kopiere diese Datei zu '.env' für die lokale Entwicklung und trage dort deine
# echten Werte ein. Die Datei '.env' darf NIEMALS in Git committet werden!
# ==============================================================================

# Node-Laufzeitumgebung (development | production | test)
NODE_ENV=production

# Port für den minimalen Health-Check-HTTP-Server (wird auf Render automatisch gesetzt)
PORT=10000

# Globale Discord-Benutzer-ID des Bot-Besitzers (Owner)
# Ermöglicht Notfallbefehle und administrative Ausführungsrechte (z. B. /verifysystem)
BOT_OWNER_ID=123456789012345678

# Gemeinsame Turso / libSQL-Datenbank
# Für Produktion (Turso Cloud): libsql://deine-db-organisation.turso.io
# Für lokale Tests: file:local.db
TURSO_DATABASE_URL=libsql://deine-datenbank-organisation.turso.io
TURSO_AUTH_TOKEN=dein-turso-auth-token-hier

# ==============================================================================
# BOT-SPEZIFISCHE TOKENS – ZWEI GETRENNTE DISCORD-BOTS
#
# Dieser Runner betreibt ZWEI vollständig getrennte Discord-Bots. Jeder Bot ist
# eine EIGENE Anwendung im Discord Developer Portal mit eigenem Token und eigener
# Application-ID (Client-ID). Alle vier Variablen sind PFLICHT – fehlt eine davon,
# bricht der Start mit einer verständlichen Fehlermeldung ab.
#
# Die Tokens und Client-IDs beider Bots dürfen NICHT identisch sein.
# ==============================================================================

# ------------------------------------------------------------------------------
# Bot 1: Verify-Bot (Verifizierungs-Bot, Christlichernico Community Server)
#        Registriert ausschließlich den Slash-Command /verifysystem
# ------------------------------------------------------------------------------
# Discord Developer Portal -> (Verify-Anwendung) -> Bot -> Token
VERIFY_BOT_TOKEN=dein-discord-verify-bot-token-hier

# Discord Developer Portal -> (Verify-Anwendung) -> General Information -> Application ID
VERIFY_BOT_CLIENT_ID=123456789012345678

# ------------------------------------------------------------------------------
# Bot 2: System-Bot (Adminpanel)
#        Registriert ausschließlich den Slash-Command /adminpanel
# ------------------------------------------------------------------------------
# Discord Developer Portal -> (System-Anwendung) -> Bot -> Token
SYSTEM_BOT_TOKEN=dein-discord-system-bot-token-hier

# Discord Developer Portal -> (System-Anwendung) -> General Information -> Application ID
SYSTEM_BOT_CLIENT_ID=987654321098765432

# Optionale Guild-ID für sofortige lokale Command-Registrierung während der Entwicklung
# (Bleibt für globale Registrierung leer; gilt für beide Bots)
DISCORD_DEV_GUILD_ID=
