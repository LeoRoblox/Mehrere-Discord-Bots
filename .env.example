# ==============================================================================
# Mehrere-Discord-Bots - Umgebungsvariablen-Vorlage (.env.example)
#
# WICHTIGER SICHERHEITSHINWEIS:
# Diese Datei enthält AUSSCHLIESSLICH Platzhalter und keine echten Geheimnisse!
# Kopiere diese Datei zu '.env' für die lokale Entwicklung und trage dort deine
# echten Werte ein. Die Datei '.env' darf NIEMALS in Git committet werden!
# ==============================================================================

# Node-Laufzeitumgebung (development | production | test)
NODE_ENV=production

# Port für den minimalen Health-Check-HTTP-Server (wird auf Render automatisch gesetzt)
PORT=10000

# Globale Discord-Benutzer-ID des Bot-Besitzers (Owner)
# Ermöglicht Notfallbefehle und administrative Ausführungsrechte
BOT_OWNER_ID=123456789012345678

# Gemeinsame Turso / libSQL-Datenbank
# Für Produktion (Turso Cloud): libsql://deine-db-organisation.turso.io
# Für lokale Tests: file:local.db
TURSO_DATABASE_URL=libsql://deine-datenbank-organisation.turso.io
TURSO_AUTH_TOKEN=dein-turso-auth-token-hier

# ==============================================================================
# BOT-SPEZIFISCHE TOKENS
# Jeder Bot besitzt seine eigene, eindeutig benannte Token-Variable.
# ==============================================================================

# Bot 1: Verifizierungs-Bot (Christlichernico Community Server)
# Discord Developer Portal -> Bot -> Token
VERIFY_BOT_TOKEN=dein-discord-verify-bot-token-hier

# Discord Client-ID / Application-ID (wird für das Registrieren von Slash-Commands benötigt)
VERIFY_BOT_CLIENT_ID=123456789012345678

# Optionale Guild-ID für sofortige lokale Command-Registrierung während der Entwicklung
# (Bleibt für globale Registrierung leer)
DISCORD_DEV_GUILD_ID=
